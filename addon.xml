<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.audio.lyrion"
       name="Lyrion"
       version="1.4.12"
       provider-name="itsonlyaudio">
  <assets>
    <icon>resources/icon-1.3.3.png</icon>
  </assets>
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Control a Lyrion Music Server player</summary>
    <description lang="en_GB">View the current track and playlist, follow playback progress, and control playback on a Lyrion Music Server.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
